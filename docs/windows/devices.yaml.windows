# Windows 部署配置模板

# ============================================
# Raman/PL 实验平台 - Windows 设备配置
# ============================================
#
# 使用说明:
# 1. 复制此文件为 devices.yaml
# 2. 修改所有标记 "← WINDOWS: 修改此处" 的配置项
# 3. 使用绝对路径或相对于项目根目录的路径
# 4. 使用双反斜杠 \\ 或正斜杠 / 作为路径分隔符
#
# ============================================

runtime:
  mode: real  # real | simulated | dry_run
  log_level: INFO  # DEBUG | INFO | WARNING | ERROR

# ============================================
# 载物台配置 (WayneLabs Linear Stage)
# ============================================
stage:
  type: waynelabs_linear

  # ← WINDOWS: 修改为实际 COM 端口
  # 使用设备管理器查看: devmgmt.msc → 端口(COM 和 LPT)
  port: COM5  # 示例: COM3, COM5, COM10

  baudrate: 9600

  # 分辨率 (微米/步)
  resolution_um:
    x: 0.15625
    y: 0.15625
    z: 0.15625

  # 默认移动速度
  default_speed: 3000

  # 软限位 (微米)
  soft_limits_um:
    x: [-50000.0, 50000.0]
    y: [-50000.0, 50000.0]
    z: [-10000.0, 10000.0]

  # 状态文件 (相对路径或绝对路径)
  state_file: data/stage_state.json
  # 或使用绝对路径:
  # state_file: C:/Users/YourName/Documents/lab_data/stage_state.json

  # 未知位置时允许的最大移动距离 (安全限制)
  max_unknown_move_um: 1000.0

# ============================================
# 光谱仪配置 (Zolix)
# ============================================
spectrometer:
  type: zolix

  # ← WINDOWS: 修改为 Zolix SDK DLL 的绝对路径
  # 通常位于厂商提供的 SDK 目录中
  dll_path: "C:\\Zolix\\SDK\\spec.dll"

  # 可选路径示例:
  # dll_path: "C:/Program Files/Zolix/SDK/x64/spec.dll"
  # dll_path: "D:\\Hardware\\Zolix\\spec.dll"

  usb_mode: true

# ============================================
# 相机配置 (NNCam)
# ============================================
camera:
  type: nncam

  # ← WINDOWS: NNCam DLL 路径
  # 项目已包含 SDK，使用相对路径:
  dll_path: "nncamsdk.20240325/win/x64/nncam.dll"

  # 或使用绝对路径:
  # dll_path: "C:\\Users\\YourName\\Documents\\自主实验平台\\nncamsdk.20240325\\win\\x64\\nncam.dll"

  # 如果使用 32-bit Python (不推荐):
  # dll_path: "nncamsdk.20240325/win/x86/nncam.dll"

# ============================================
# 光源控制配置 (PWM Modbus)
# ============================================
light:
  type: pwm_modbus  # pwm_modbus | manual

  # 手动控制模式 (false = 自动控制, true = 提示操作员)
  manual_light_control: false

  # ← WINDOWS: 修改为 PWM 控制器的 COM 端口
  port: COM17  # 示例: COM17

  # Modbus 站号
  station_id: 1

  # 串口波特率
  baudrate: 9600

  # 电压限制 (V)
  max_output_voltage_v: 5.0
  required_output_voltage_v: 3.3

  # PWM 通道配置
  channels:
    # 激光通道
    laser:
      channel: 1  # ← WINDOWS: 根据硬件接线修改
      frequency_hz: 1000
      duty_percent: 50.0
      default_off_required: true  # 启动时必须关闭

    # LED 通道
    led:
      channel: 2  # ← WINDOWS: 根据硬件接线修改
      frequency_hz: 1000
      duty_percent: 30.0
      default_off_required: false

# ============================================
# 手动光源控制示例 (不使用 PWM 控制器)
# ============================================
# light:
#   type: manual
#   manual_light_control: true

# ============================================
# 模拟模式示例 (用于开发/测试)
# ============================================
# runtime:
#   mode: simulated  # 所有硬件使用模拟设备
#   log_level: DEBUG

# ============================================
# Dry Run 模式示例 (生成命令但不执行)
# ============================================
# runtime:
#   mode: dry_run  # 打印命令但不发送到硬件
#   log_level: INFO

# ============================================
# Windows 路径注意事项
# ============================================
#
# 正确的路径格式:
# ✓ dll_path: "C:\\Zolix\\SDK\\spec.dll"      (双反斜杠)
# ✓ dll_path: "C:/Zolix/SDK/spec.dll"          (正斜杠)
# ✓ dll_path: r"C:\Zolix\SDK\spec.dll"         (原始字符串, Python 代码中)
#
# 错误的路径格式:
# ✗ dll_path: "C:\Zolix\SDK\spec.dll"          (单反斜杠会被转义)
# ✗ dll_path: C:\Zolix\SDK\spec.dll            (缺少引号)
#
# 相对路径:
# ✓ dll_path: "nncamsdk.20240325/win/x64/nncam.dll"
# ✓ state_file: data/stage_state.json
#
# 相对路径从项目根目录开始解析
# ============================================

# ============================================
# COM 端口检测
# ============================================
#
# 运行以下命令查看可用 COM 端口:
#   check_ports.bat
#
# 或在 Python 中:
#   python -m serial.tools.list_ports
#
# 设备管理器中查看:
#   Win+R → devmgmt.msc → 端口(COM 和 LPT)
# ============================================

# ============================================
# 故障排查
# ============================================
#
# COM 端口访问被拒绝:
#   1. 关闭其他串口工具
#   2. 在设备管理器中禁用/重新启用端口
#   3. 以管理员身份运行
#
# DLL 加载失败:
#   1. 确认路径正确 (使用绝对路径)
#   2. 确认 DLL 位数匹配 Python 位数
#   3. 安装 Visual C++ Redistributable
#   4. 使用 Dependency Walker 检查依赖
#
# 相机检测失败:
#   1. 确认 USB 连接
#   2. 安装相机驱动
#   3. 测试 SDK 示例程序
# ============================================
